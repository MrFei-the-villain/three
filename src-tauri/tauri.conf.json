{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Three",
  "version": "1.0.0",
  "identifier": "app.three.queue",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Three",
        "width": 480,
        "height": 760,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true,
        "backgroundColor": "#f3ede5"
      },
      {
        "label": "tiny",
        "url": "tiny.html",
        "title": "Three",
        "width": 340,
        "height": 236,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "backgroundColor": "#f3ede5"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
